.test-page {
  display: flex;
  flex-direction: column;
  padding-top: 24rpx;
}

/* 不显示进度，只留一个题号作为排版元素 */
.q-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #151515;
  margin-bottom: 36rpx;
}

.q-no {
  font-size: 76rpx;
  line-height: 0.9;
  font-weight: 400;
  letter-spacing: -2rpx;
}

.q-tag {
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: rgba(21, 21, 21, 0.42);
  padding-bottom: 8rpx;
}

.progress-track {
  height: 8rpx;
  background: rgba(21, 21, 21, 0.1);
  border-radius: 999rpx;
  overflow: hidden;
  margin: -20rpx 0 36rpx;
}

.progress-fill {
  height: 100%;
  background: #b7f34a;
  transition: width 180ms ease;
}

.question-text {
  font-size: 38rpx;
  line-height: 1.55;
  font-weight: 600;
  letter-spacing: -0.5rpx;
  margin-bottom: 40rpx;
}

.opts {
  border-top: 0;
}

.option {
  display: block;
  border: 1rpx solid rgba(22, 35, 61, 0.12);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  padding: 28rpx 26rpx;
  margin-bottom: 16rpx;
}

.option-text {
  font-size: 29rpx;
  line-height: 1.65;
}

.option-active {
  background: #151515;
  color: #f7f6f2;
  border-color: #16233d;
  box-shadow: 0 10rpx 20rpx rgba(22, 35, 61, 0.12);
}

.q-foot {
  display: flex;
  gap: 40rpx;
  margin-top: 32rpx;
}

.qlink {
  font-size: 25rpx;
  color: rgba(21, 21, 21, 0.45);
  letter-spacing: 1rpx;
}

.test-page .q-head {
  border-bottom-color: rgba(22, 35, 61, 0.22);
}

.test-page .progress-fill {
  background: #62e6d2;
}

.test-page .option-active {
  background: #16233d;
  color: #f3f6fb;
}

/* 物种鉴定卡视觉 */

.option { background: #fffefa; border: 2rpx solid #dedfd7; border-radius: 28rpx; padding: 32rpx; display: flex; align-items: center; }
.option-text { flex: 1; }
.option::after { content: ''; width: 28rpx; height: 28rpx; border: 2rpx solid #b9c4bc; border-radius: 50%; margin-left: 20rpx; }
.option-active { background: #def4e9; border-color: #459b7e; }
.option-active::after { background: #285c49; }
