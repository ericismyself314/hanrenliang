<view class="container test-page">

  <view class="q-head">
    <text class="q-no mono">{{no}}</text>
  </view>

  <view class="progress-track">
    <view class="progress-fill" style="width:{{progressWidth}}"></view>
  </view>

  <view class="question-text">{{text}}</view>

  <view class="opts">
    <view
      wx:for="{{options}}"
      wx:key="id"
      class="option {{selected === item.id ? 'option-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="choose"
    >
      <view class="option-text">{{item.text}}</view>
    </view>
  </view>

  <view class="q-foot">
    <text class="qlink" wx:if="{{hasPrev}}" bindtap="prev">上一题</text>
    <text class="qlink" bindtap="restart">重新开始</text>
  </view>

  <view class="error-box" wx:if="{{errorMessage}}">
    <text class="warn">{{errorMessage}}</text>
  </view>

</view>
