/* 含人量 · 校园蓝图 / 夜航信号站
   主色 深蓝 #16233D / 雾蓝 #F3F6FB / 信号青 #62E6D2 / 辅助紫 #9C8CFF */

page {
  background: #edf2f9;
  color: #16233d;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}

.container {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
}

.mono {
  font-family: 'SF Mono', 'DIN Alternate', Menlo, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

/* ---------- 检测站元素 ---------- */

.station-line {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  letter-spacing: 1.5rpx;
  color: rgba(22, 35, 61, 0.48);
}

.station-line .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #62e6d2;
  border: 2rpx solid #16233d;
  margin-right: 12rpx;
}

.station-line .rule {
  flex: 1;
  height: 1rpx;
  background: rgba(22, 35, 61, 0.16);
  margin-left: 16rpx;
}

/* ---------- 排版 ---------- */

.h1 {
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 600;
  margin: 24rpx 0 0;
}

.h2 {
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 600;
  margin: 0 0 16rpx;
}

.h3 {
  font-size: 32rpx;
  font-weight: 600;
  margin: 0 0 12rpx;
}

.lead {
  font-size: 30rpx;
  color: rgba(22, 35, 61, 0.7);
  margin: 20rpx 0 0;
}

.muted {
  font-size: 26rpx;
  color: rgba(22, 35, 61, 0.55);
}

.warn {
  color: #c65d4e;
}

/* ---------- 卡片 ---------- */

.card {
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(22, 35, 61, 0.1);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 34rpx rgba(42, 64, 102, 0.08);
}

.card-flat {
  background: #e4ecf8;
  border-radius: 18rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: rgba(22, 35, 61, 0.52);
  margin-bottom: 16rpx;
}

/* ---------- 按钮 ---------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: 1rpx solid transparent;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #16233d;
  color: #f3f6fb;
  box-shadow: 0 10rpx 20rpx rgba(22, 35, 61, 0.18);
}

.btn-primary.btn-hover {
  background: #243657;
}

.btn-signal {
  background: #62e6d2;
  color: #16233d;
  border-color: #16233d;
  box-shadow: 0 10rpx 20rpx rgba(98, 230, 210, 0.2);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.72);
  color: #16233d;
  border: 1rpx solid rgba(22, 35, 61, 0.2);
}

.btn-block-gap {
  margin-top: 20rpx;
}

button[disabled] {
  opacity: 0.48;
}

/* ---------- 其他 ---------- */

.divider {
  height: 1rpx;
  background: rgba(22, 35, 61, 0.1);
  margin: 28rpx 0;
}

.error-box {
  border: 1rpx solid rgba(198, 93, 78, 0.38);
  background: rgba(198, 93, 78, 0.08);
  border-radius: 18rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.center {
  text-align: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer-note {
  margin-top: 32rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: rgba(22, 35, 61, 0.44);
  text-align: center;
}

.invite-done {
  background: rgba(98, 230, 210, 0.18);
  border: 1rpx solid rgba(22, 35, 61, 0.14);
}

.text-action {
  display: block;
  padding: 20rpx 0 0;
  text-align: center;
  color: #5d55b8;
  font-size: 26rpx;
}

/* 物种鉴定卡视觉 */
page { background: #f8f7f2; } .btn { border-radius: 28rpx; } .btn:active { opacity: .86; transform: translateY(2rpx); }
